	/// Hex colour for booking status bars: green for Checked Out, red for Cancelled, amber for No Show. Used as a Field value colour on the Bookings by Status chart.
	measure 'Booking Status Color' = SWITCH(SELECTEDVALUE(fact_bookings[booking_status]), "Checked Out", [Color Green], "Cancelled", [Color Red], "No Show", "#F4B23E", [Color Neutral])
		displayFolder: Conditional Formatting\Palette
