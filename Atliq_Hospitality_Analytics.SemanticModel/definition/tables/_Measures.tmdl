	/// Hex colour used for positive/favourable change (green).
	measure 'Color Green' = "#2E9E5B"
		displayFolder: Conditional Formatting\Palette
		lineageTag: 175f2fff-65e3-4dfa-ac53-e765cd9abbcd

	/// Hex colour used for negative/unfavourable change (red).
	measure 'Color Red' = "#D64545"
		displayFolder: Conditional Formatting\Palette
		lineageTag: 8be0ff55-abe2-435d-add5-b8c4f25869ae

	/// Hex colour used for no change or unavailable data (grey).
	measure 'Color Neutral' = "#7F7F7F"
		displayFolder: Conditional Formatting\Palette
		lineageTag: 324ad636-31a5-46f7-bf0c-adb43c73cca3

	/// Conditional-formatting colour for Revenue MoM change %: green for an increase, red for a decrease, grey for no change or no data (an increase is favourable). Use in Format > Conditional formatting > Field value.
	measure 'Revenue MoM Color' =
			VAR chg = [Revenue MoM change %]
			RETURN SWITCH(TRUE(), ISBLANK(chg), [Color Neutral], chg > 0, [Color Green], chg < 0, [Color Red], [Color Neutral])
		displayFolder: Conditional Formatting\Month over Month
		lineageTag: 5a6318d2-57ae-4575-b268-1fe9d96c0609

	/// Conditional-formatting colour for Occupancy % MoM change %: green for an increase, red for a decrease, grey for no change or no data (an increase is favourable). Use in Format > Conditional formatting > Field value.
	measure 'Occupancy % MoM Color' =
			VAR chg = [Occupancy % MoM change %]
			RETURN SWITCH(TRUE(), ISBLANK(chg), [Color Neutral], chg > 0, [Color Green], chg < 0, [Color Red], [Color Neutral])
		displayFolder: Conditional Formatting\Month over Month
		lineageTag: c812a67e-d6c4-468b-82ec-1dbeaef34e85

	/// Conditional-formatting colour for Average Rating MoM change %: green for an increase, red for a decrease, grey for no change or no data (an increase is favourable). Use in Format > Conditional formatting > Field value.
